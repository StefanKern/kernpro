{
  "name": "kernpro",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "nx serve kernpro",
    "start-en": "nx serve kernpro --configuration=en",
    "build": "nx build kernpro --localize",
    "watch": "nx build kernpro --watch --configuration development",
    "test": "nx test",
    "serve:ssr:kernpro:de": "node dist/kernpro/server/de/server.mjs",
    "serve:ssr:kernpro:en": "node dist/kernpro/server/en/server.mjs",
    "deploy": "firebase deploy",
    "extract-i18n": "nx extract-i18n kernpro",
    "i18n:merge": "xliffmerge --profile xliffmerge.json",
    "i18n:extract-and-merge": "nx extract-i18n kernpro && npm run i18n:merge",
    "build-and-publish-wordcloud": "nx build wordcloud && npm publish ./dist/libs/wordcloud --access public",
    "build-and-publish-kernpro": "nx build kernpro --localize && firebase deploy"
  },
  "private": true,
